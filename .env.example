# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.
#
#   cp .env.example .env.local
#
# On Vercel these are set under Project Settings -> Environment Variables.
# Everything below is a placeholder: no real credential belongs in this file.

# --- Public (inlined into the browser bundle — put nothing secret here) ---

# Absolute base URL of the deployment, with no trailing slash.
#
# REQUIRED IN PRODUCTION. Used for canonical/OG URLs and Stripe's return URLs.
# If unset, the app falls back to Vercel's deployment URL, and in local
# development to http://localhost:3000. It will never emit a localhost URL in
# production — it omits the canonical and refuses checkout instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin area (protects /admin/*) ---
#
# REQUIRED IN PRODUCTION. Without both, /admin returns 503 and stays locked —
# it never falls open. Use a long, randomly generated password; this is HTTP
# Basic auth over HTTPS, not a full identity system.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Stripe ---
#
# Checkout needs all three of the following. If any is missing, checkout runs
# in a preview mode locally and is disabled outright in production.
#
# Create two products in the Stripe dashboard, each with one price:
#   1. "AI Quote Assistant — Setup",   GBP 149.00, one-off  -> STRIPE_PRICE_SETUP
#   2. "AI Quote Assistant — Monthly", GBP 79.00, monthly   -> STRIPE_PRICE_MONTHLY
# Both ids start with "price_". Product ids ("prod_") will not work.
#
# Two products rather than one with two prices: Checkout renders the *product*
# name per line item, so a single product shows the customer the same name
# twice at two different amounts with nothing to tell them apart.
#
# Leave each price's tax behaviour "unspecified" until the VAT question in
# lib/pricing.ts is settled — it is immutable once set, and changing it means
# creating a new price and repointing these variables.

# Secret key. Use the test key (sk_test_...) until you are ready to take money.
STRIPE_SECRET_KEY=

# Price id for the one-off setup fee.
STRIPE_PRICE_SETUP=

# Price id for the recurring monthly subscription.
STRIPE_PRICE_MONTHLY=

# Signing secret for the webhook endpoint at /api/stripe/webhook. Without it
# that route returns 503 and accepts nothing — it never processes an unverified
# payload.
#
# Two different secrets, depending on where events come from:
#   - `stripe listen --latest --forward-to localhost:3000/api/stripe/webhook`
#     prints one for local development. It changes each time you start the CLI.
#   - A dashboard event destination has its own, shown once on creation.
#
# Payloads are serialised at the account's (or destination's) API version, not
# the SDK's, so aim for 2026-07-29.dahlia to match the pinned SDK. `--latest`
# does that locally. The account default can only be changed in live mode, so
# in test mode set `api_version` on the destination itself instead.
STRIPE_WEBHOOK_SECRET=

# --- AI model (DeepSeek) ---
#
# OPTIONAL, AND OFF BY DEFAULT. Without it the assistant runs on the
# deterministic offline engine, which works fully — it is just less naturally
# worded.
#
# The model never drives the conversation: it proposes what the customer said
# and suggests wording, and the offline engine remains the state machine. See
# app/api/assistant/route.ts.
#
# Requests are rate limited per IP (10/min, 60/hr) with a global daily ceiling.
# See lib/rate-limit.ts for what that does and does not guarantee.

# Master switch for the live model. Unset, blank or anything other than
# true/1/yes means OFF, and nothing is sent to DeepSeek regardless of the
# credentials below.
#
# DO NOT SET THIS TO true IN PRODUCTION. DeepSeek processes conversation
# content in China. Transferring personal data there needs a GDPR Chapter V
# basis (Art. 46 Standard Contractual Clauses plus a transfer impact
# assessment), and that is not in place — it is the open item in section 6 of
# BUSINESS_PLAN.md. Leave this off until it is.
ASSISTANT_MODEL_ENABLED=false

# Secret key from the DeepSeek console. Server-side only; never exposed.
# Ignored entirely while ASSISTANT_MODEL_ENABLED is off.
DEEPSEEK_API_KEY=

# Exact model id, copied from DeepSeek's own documentation. Deliberately has no
# default: a wrong or invented model id fails as a confusing 400 rather than an
# obvious misconfiguration.
DEEPSEEK_MODEL=

# Override only if DeepSeek changes its API origin.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

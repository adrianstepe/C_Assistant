# Copy to .env.local and fill in. .env.local is git-ignored — never commit real values.
#
#   cp .env.example .env.local
#
# On Vercel these are set under Project Settings -> Environment Variables.

# --- Public (inlined into the browser bundle — put nothing secret here) ---

# Absolute base URL of the deployment, with no trailing slash.
# Used for canonical/OG URLs and for Stripe's return URLs. Set this in
# production: without it, Stripe redirects fall back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never exposed to the browser) ---

# Anthropic API key for the quote assistant. Not consumed by any code yet —
# the demo runs on a deterministic local engine.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model id for the quote assistant, e.g. claude-sonnet-5.
ANTHROPIC_MODEL=

# --- Stripe ---
#
# Checkout needs all three of the following. If any is missing, checkout runs
# in a preview mode locally and is disabled outright in production.
#
# Create two prices in the Stripe dashboard against one product:
#   1. £149.00 GBP, one-off       -> STRIPE_PRICE_SETUP
#   2. £79.00 GBP, recurring/month -> STRIPE_PRICE_MONTHLY
# Both ids start with "price_". Product ids ("prod_") will not work.

# Secret key. Use the test key (sk_test_...) until you are ready to take money.
STRIPE_SECRET_KEY=

# Price id for the one-off setup fee.
STRIPE_PRICE_SETUP=

# Price id for the recurring monthly subscription.
STRIPE_PRICE_MONTHLY=

# Signing secret for the Stripe webhook endpoint. Not used yet: no webhook
# handler exists because nothing is persisted. Needed once orders are stored.
STRIPE_WEBHOOK_SECRET=
